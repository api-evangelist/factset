                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/linkup/job-listings?_sort=-startDate&_paginationLimit=20&_paginationOffset=0&startDate=<date>&endDate=<date>&type=delta",
