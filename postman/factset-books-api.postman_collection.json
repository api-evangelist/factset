                  "name": "Factset Retrieves Book in Pdf Format",
                  "id": "5c59280e-73f5-4c4d-90a3-13a2084c35af",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
