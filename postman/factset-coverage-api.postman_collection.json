          "name": "coverage",
          "item": [
            {
              "name": "Factset Returns the Coverage for the Requested Ticker/isin Along With Other Response Fields for Level1 Data.",
              "id": "2abc1136-999d-4eb2-9b0d-cfc1c9471e13",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/level1/coverage?tickers=<string>,<string>&factsetExchangeCode=<string>&isins=<string>,<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "level1",
                    "coverage"
                  ],
                  "query": [
                    {
                      "description": "<P> The requested list of one or more tickers.</p>\n\n The `tickers` and `isins`  parameters provide two different ways to specify the identifiers for data retrieved. Please enter either the tickers or isins parameter.\n \n<P> Maximum 10 tickers per request</p>  \n \n",
                      "key": "tickers",
                      "value": "<string>,<string>"
                    },
                    {
                      "description": "<p>This parameter is used to filter the results based on the FactSet specific regional or composite exchange code.</p>\n**NOTE**:Does not support multiple factsetExchangeCodes",
                      "key": "factsetExchangeCode",
                      "value": "<string>"
                    },
                    {
                      "description": "<P> Specifies the ISIN of the record. </p>\n\n  Please enter either the `tickers` or `isins` parameter. \n  \n<P> Maximum 10 ISINs per request.</p>   \n \n",
                      "key": "isins",
                      "value": "<string>,<string>"
                    }
                  ]
                },
                "description": "Returns coverage for specified tickers for Level1 Data"
              },
