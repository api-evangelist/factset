                  "name": "Factset Returns the Jobid",
                  "id": "3bfc0d0a-4911-410f-b8b3-e84e3f54eb3f",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/streetaccount/historical/request-files?startDate=<dateTime>&endDate=<dateTime>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "streetaccount",
                        "historical",
                        "request-files"
                      ],
                      "query": [
                        {
                          "description": "(Required) Date from which data is required. Should be YYYY-MM-DDTHH:MM:SSZ format",
                          "key": "startDate",
                          "value": "<dateTime>"
                        },
                        {
                          "description": "(Required) The date until which the data is to be fetched. Should be YYYY-MM-DDTHH:MM:SSZ format",
                          "key": "endDate",
                          "value": "<dateTime>"
                        }
                      ]
                    },
                    "description": "Give the startDate and endDate parameters as request parameters in the /request-files endpoint, it returns the jobID. startDate and endDate should be in YYYY-MM-DDTHH:MM:SSZ format. This API only supports adhoc requests to retrieve historical files and does not support real-time files and if you interested in require real-time push should consider the other three methods (pushed via SFTP, to QNT account, or your Azure Storage). Per API request able to query till 2 years of data"
                  },
