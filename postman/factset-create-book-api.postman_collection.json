                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"book_name\": \"<string>\",\n  \"ticker\": \"<string>\",\n  \"pagination\": {\n    \"cover\": {\n      \"example\": \"true\"\n    },\n    \"divider\": {\n      \"example\": \"true\"\n    },\n    \"toc\": {\n      \"example\": \"true\"\n    }\n  },\n  \"content\": [\n    {\n      \"section_id\": {\n        \"example\": \"COMPANY_OVERVIEW\"\n      },\n      \"reports\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    },\n    {\n      \"section_id\": {\n        \"example\": \"COMPANY_OVERVIEW\"\n      },\n      \"reports\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  ]\n}",
