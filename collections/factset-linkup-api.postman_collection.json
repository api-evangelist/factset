      "name": "Linkup",
      "description": {
        "content": "<a href=https://go.factset.com/marketplace/catalog/product/linkup-raw>LinkUp</a> API provides access to job listings data.  \n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6a53bfa6-679c-4331-8fd6-37f5e9feaf38",
          "name": "Returns the  daily files from Open:FactSet Partner - LinkUp. The LinkUp API provides access to job listings dataset that is sourced directly from employer webistes globally delivered daily.",
          "request": {
            "name": "Returns the  daily files from Open:FactSet Partner - LinkUp. The LinkUp API provides access to job listings dataset that is sourced directly from employer webistes globally delivered daily.",
            "description": {
              "content": "Returns the  daily files from Open:FactSet Partner - LinkUp. The LinkUp API provides access to job listings dataset that is sourced directly from employer webistes globally delivered daily. **This API is no longer being sold for new clients.**",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "linkup",
                "job-listings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "_sort",
                  "value": "-startDate",
                  "description": "Enables to get the data in ascending or descending order based on startTime. Results are in reverse chronological order if this parameter is not used."
                },
                {
                  "disabled": false,
                  "key": "_paginationLimit",
                  "value": "20",
                  "description": "Specifies the maximum number of results to return per result."
                },
                {
                  "disabled": false,
                  "key": "_paginationOffset",
                  "value": "0",
                  "description": "Specifies the starting point for pagination. This parameter is used to identify the beginning of next set of results. Using this parameter can fetch maximum of first 10000 records."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<date>",
                  "description": "The earliest date of the LinkUp file the API should fetching for based on fileTimestamp."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<date>",
                  "description": "The latest date of the LinkUp file the API should fetching for based on fileTimestamp."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "delta",
                  "description": "Used to provide the full job descriptions when value \"full\" is used for this parameter."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
