{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "About",
        "type": "folder"
      },
      "items": [
        {
          "info": {
