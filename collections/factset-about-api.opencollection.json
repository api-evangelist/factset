            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path",
                "description": "contactId of associated record"
              }
            ]
          },
          "docs": "Factset Get the About Field Content for a Specific Contact"
        }
      ]
    }
  ],
  "bundled": true
