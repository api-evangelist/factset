{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Sentiments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sentiments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Get All Sentiments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/v1/sentiments"
          },
          "docs": "Factset Get All Sentiments"
        }
      ]
    }
  ],
  "bundled": true
}