          "name": "Factset Trigger Prb Jobs",
          "request": {
            "name": "Factset Trigger Prb Jobs",
            "description": {
              "content": "Use this endpoint with with POST method to trigger PRB jobs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "runs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"jobName\": \"<string>\",\n    \"jobType\": \"<string>\",\n    \"overrides\": {\n      \"calendar\": \"fiveDay\",\n      \"combinations\": [\n        {\n          \"accounts\": [\n            \"<string>\",\n            \"<string>\"\n          ],\n          \"dates\": [\n            \"<date>\",\n            \"<date>\"\n          ]\n        },\n        {\n          \"accounts\": [\n            \"<string>\",\n            \"<string>\"\n          ],\n          \"dates\": [\n            \"<date>\",\n            \"<date>\"\n          ]\n        }\n      ],\n      \"dates\": {\n        \"end\": \"<date>\",\n        \"start\": \"<date>\"\n      },\n      \"frequency\": \"daily\",\n      \"runAsOfDate\": \"<date>\",\n      \"runAsSerialNumber\": \"<string>\",\n      \"tasks\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "8a9f3171-e6ff-470b-8bba-b86688acdf32",
              "name": "Expected response, the job has been accepted, please use /runs/{id}/status to poll status and check progress",
              "originalRequest": {
                "url": {
                  "path": [
                    "runs"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
