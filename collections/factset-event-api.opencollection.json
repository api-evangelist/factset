{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Event API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Event",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getEventDetailById",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/events/details/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path",
                "description": "The UUID of the event to return."
              }
            ]
          },
          "docs": "Fetch Signals event headlines plus all additional event details for a single requested Signal event"
        }
      ]
    }
  ],
  "bundled": true
}