{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Signal API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Signal",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getDataDictionaryById",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/data-dictionary/:signalId",
            "params": [
              {
                "name": "signalId",
                "value": "dilutionTrigger",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch the metadata and contract for the requested signal"
        }
      ]
    }
  ],
  "bundled": true
}