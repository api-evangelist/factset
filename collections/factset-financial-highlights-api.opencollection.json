{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Financial Highlights API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Financial Highlights",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Financial / Estimate Highlights",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/financial-highlights",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Company ticker"
              },
              {
                "name": "actual",
                "value": "",
                "type": "query",
                "description": "The number of actual data periods to be returned. Must be greater than 0"
              },
              {
                "name": "estimate",
                "value": "",
                "type": "query",
                "description": "The number of estimate data periods to be returned. Must be greater than 0"
              }
            ]
          },
          "docs": "Factset Financial / Estimate Highlights"
        }
      ]
    }
  ],
  "bundled": true
}