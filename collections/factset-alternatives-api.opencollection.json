{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Alternatives API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alternatives",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset List of Alternative Units.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/basic/valueUnit/alternative/list",
            "params": [
              {
                "name": "_attributes",
                "value": "",
                "type": "query",
                "description": "Limit the attributes returned in the response to the specified set."
              },
              {
                "name": "_language",
                "value": "",
                "type": "query"
              },
              {
                "name": "_sort",
                "value": "",
                "type": "query",
                "description": "Sortable attributes. The sort order is ascending unless it is prefixed with a minus sign, in which case it is descending. A list of at most 1 (possibly prefixed) attribute name(s) is allowed."
              }
            ]
          },
          "docs": "List of alternative units."
        }
      ]
    }
  ],
  "bundled": true
}