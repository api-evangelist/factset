{
  "item": [
    {
      "id": "3d10d0ea-2c10-4e95-a427-f2479b207381",
      "name": "Segments",
      "description": {
        "content": "Access business and geographic segment data including revenue, operating income, assets, depreciation, and capital expenditures by segment.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f9f3a2e9-56e5-4f70-8ff4-bab62f21e2a3",
          "name": "Factset Returns Company Segment Data.",
          "request": {
            "name": "Factset Returns Company Segment Data.",
            "description": {
              "content": "Retrieves business and geographic segment data for individual companies. Segment metrics include SALES, OPINC (operating income), ASSETS, DEP (depreciation), and CAPEX (capital expenditures).\n\nThe `/segments` endpoint supports Long Running asynchronous requests up to **20 minutes** via batch parameter. Id limits are increased to 2,000 ids per request when using batch capability.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "segments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "(Required) The requested list of security identifiers. Accepted ID types include Market Tickers, SEDOL, ISINs, CUSIPs, or FactSet Permanent Ids. Limit of 1,000 per non-batch request / 2,000 per batch request (GET) or 30,000 per batch request (POST)."
                },
                {
                  "disabled": false,
                  "key": "metrics",
                  "value": "<string>",
                  "description": "(Required) Segment data metric. SALES = Sales/Revenue, OPINC = Operating Income/Loss, ASSETS = Total Assets, DEP = Depreciation Expense, CAPEX = Capital Expenditures."
                },
                {
                  "disabled": false,
                  "key": "segmentType",
                  "value": "BUS",
                  "description": "Segment type for the metrics. BUS = Business segments, GEO = Geographic segments."
                },
                {
                  "disabled": false,
                  "key": "periodicity",
                  "value": "ANN",
                  "description": "Periodicity for segment data. ANN = Annual Original, ANN_R = Annual Latest (includes restatements)."
                },
                {
                  "disabled": false,
                  "key": "fiscalPeriodStart",
                  "value": "<date>",
                  "description": "The fiscal period start expressed as YYYY-MM-DD. Calendar date that will fall back to the most recent completed period during resolution."
                },
                {
                  "disabled": false,
                  "key": "fiscalPeriodEnd",
                  "value": "<date>",
                  "description": "The fiscal period end expressed as YYYY-MM-DD. Calendar date that will fall back to the most recently completed period during resolution."
                },
                {
                  "disabled": false,
                  "key": "batch",
                  "value": "N",
                  "description": "Enables asynchronous batch processing, supporting long-running requests up to 20 minutes. Upon requesting batch=Y, the service will respond with HTTP 202. Use batch-status to check completion and batch-result to retrieve results."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
