      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Product",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Gets a List of Product Types That a User Has Access To.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.factset.com/analytics/pub-datastore/tag-search/v1/product-types/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a list of product types that have been specified across all documents the user has access to"
        }
      ]
    }
  ],
  "bundled": true
}