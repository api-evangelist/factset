          "name": "Fetch Factset Answer in Adaptive Card Format",
          "request": {
            "name": "Fetch Factset Answer in Adaptive Card Format",
            "description": {
              "content": "Returns an answer to the specified query (if valid answer exists) in the Adaptive Card format (https://adaptivecards.io/).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search",
                "answers",
                "v1",
                "adaptive-card"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) Query for desired answer (e.g., \"fds price\")"
                },
                {
                  "disabled": false,
                  "key": "includeThumbnail",
                  "value": "false",
                  "description": "Includes thumbnail of Adaptive Card in response"
                },
                {
                  "disabled": false,
                  "key": "disableNoAnswerResponses",
                  "value": "true",
                  "description": "Disables no-result answer responses (no-results and answer without data)"
                },
                {
                  "disabled": false,
                  "key": "theme",
                  "value": "Light",
                  "description": "Theme for desired answer (e.g., \"Light\", \"Dark\")"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
