                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"book_name\": \"Company Book for FDS\",\n  \"ticker\": \"FDS-US\",\n  \"pagination\": {\n    \"cover\": {},\n    \"divider\": {},\n    \"toc\": {}\n  },\n  \"content\": [\n    {\n      \"section_id\": {},\n      \"reports\": [\n        \"COMPANY_SNAPSHOT_IB\",\n        \"COMPANY_SNAPSHOT_IB\"\n      ]\n    },\n    {\n      \"section_id\": {},\n      \"reports\": [\n        \"COMPANY_SNAPSHOT_IB\",\n        \"COMPANY_SNAPSHOT_IB\"\n      ]\n    }\n  ]\n}",
                  "options": {
