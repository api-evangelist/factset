          "id": "6e8b1606-696b-4c66-8ada-ba5274f2300e",
          "name": "Factset Kicks off request to create a book with reports of your choice",
          "request": {
            "name": "Factset Kicks off request to create a book with reports of your choice",
            "description": {
              "content": "This end point retrieves book name and book_id for the PDF book you create. All the book options such as name of the book, ticker, pagination options, and reports can be specified in the request body. Please refer to the documentation for valid section ids and report ids.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "create-book"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_name\": \"<string>\",\n  \"ticker\": \"<string>\",\n  \"pagination\": {\n    \"cover\": {},\n    \"divider\": {},\n    \"toc\": {}\n  },\n  \"content\": [\n    {\n      \"section_id\": {},\n      \"reports\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    },\n    {\n      \"section_id\": {},\n      \"reports\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "f564999e-cf99-4c6a-be82-09ee2598ee22",
              "name": "Successful response contains book name and book ID",
              "originalRequest": {
