{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Benchmark API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
