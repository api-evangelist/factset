          "name": "Factset Get Basic Reference Summary Data for a Fund.",
          "request": {
            "name": "Factset Get Basic Reference Summary Data for a Fund.",
            "description": {
              "content": "Fetch basic reference data for the requested fund(s), including countryDomicile, shrClass, shrClassInceptDate, etc. \n",
              "type": "text/plain"
            },
