          "id": "0134597f-50e6-407d-a49a-c7c8ebcc3fb1",
          "name": "Factset Request Returns Data for the First Trade (official and Unofficial) After the Specified Time",
          "request": {
            "name": "Factset Request Returns Data for the First Trade (official and Unofficial) After the Specified Time",
            "description": {
              "content": "",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "TickHistory",
                "firsttrade"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) Requested symbol or security. The symbol can be a FactSet exchange symbol, CUSIP, or SEDOL. **NOTE**: Only one identifier can be requested per request.<P>**TRY IT OUT** - Choose One from - BABA-USA,WALMEX-MX,7203-TKS,VOD-LON,NPN-JSE,MABAX,NZF,SPY-USA,AGG-USA,GLD-USA,AOR-USA,MNA-USA,UUP-USA,SP50-SPX,ESX-STX,XAO-ASX,WD-MSX,NG00-USA,GC00-USA,CC00-USA,C00-USA,FC00-USA,ER00-USA,EURUSD-FX1,USDMXN-FX1,AUDJPY-FX1,EURCZK-FX1,USDILS-FX1,USDZAR-FX1,US10YY-TU1,FDS#190621C00145000-USA,FDS#190621P00145000-USA"
                },
                {
                  "disabled": false,
                  "key": "req_id",
                  "value": "<string>",
                  "description": "Request Identification String. Can be used by the application to keep track of requests. The id is not used by this service, however, it is included in the XML response."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "This is the start date for the Snapshot History. Requests should be made in the format YYYYMMDD Default is current business day. Field can be sd or date. TRY IT OUT Cannot use current day."
                },
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "040000",
                  "description": "This is the start time for the snapshot history requested. Requests should be made in a **HHMMSSS** format.Range from 000000 - 235959. **TRY IT OUT** Cannot use current day"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "XML",
                  "description": "The format of the output file. TRY IT OUT Choose from JSON, CSV, CSV_NO_HEADER"
                },
                {
                  "disabled": false,
                  "key": "include_request",
                  "value": "false",
                  "description": "Flag to include request id and key in the CSV output."
                },
                {
                  "disabled": false,
                  "key": "dataset",
                  "value": "<string>",
                  "description": "Decides what type of trades to return, default is all trades and quotes, alternatively charting can be selected which will filter out unofficial trades."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
