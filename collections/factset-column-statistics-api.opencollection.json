{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Column Statistics API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Column Statistics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Get Pa Column Statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/analytics/engines/pa/v3/columnstatistics"
          },
          "docs": "This endpoint lists all the column statistics that can be applied to a PA column."
        }
      ]
    }
  ],
  "bundled": true
}