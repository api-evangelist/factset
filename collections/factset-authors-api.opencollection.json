{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Authors API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Get All Authors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/v1/authors",
            "headers": [
              {
                "name": "X-IRN-Ignore-Permissions",
                "value": ""
              }
            ]
          },
          "docs": "Factset Get All Authors"
        }
      ]
    }
  ],
  "bundled": true
}