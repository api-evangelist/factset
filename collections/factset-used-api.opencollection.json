{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Used API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Used",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Retrieve a Collection of Attributes Group Records in Use.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/ofs/v2/attributes/groups/used",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the amount of records per page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Select which page to show"
              }
            ]
          },
          "docs": "Factset Retrieve a Collection of Attributes Group Records in Use."
        }
      ]
    }
  ],
  "bundled": true
}