                "description": "symbolRelationshipId to get associated record"
              }
            ]
          },
          "docs": "Factset Get Details on a Specific Symbol Relationship"
        },
        {
          "info": {
            "name": "Factset Delete a Symbol Relationship",
            "type": "http"
