            ]
          },
          "docs": "Factset Returns a List of a Symbols Relationships"
        },
        {
          "info": {
            "name": "Factset Get Details on a Specific Symbol Relationship",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/v1/symbol-relationships/:symbolRelationshipId",
            "params": [
              {
                "name": "symbolRelationshipId",
                "value": "",
