        {
          "info": {
            "name": "Factset Edit a Symbol Relationship",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.factset.com/v1/symbol-relationships/:symbol",
            "params": [
              {
                "name": "symbol",
                "value": "",
