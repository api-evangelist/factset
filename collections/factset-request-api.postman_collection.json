          "id": "84bc54e6-dc06-4c6b-b9f5-951bd98a15b5",
          "name": "Factset Returns the Jobid",
          "request": {
            "name": "Factset Returns the Jobid",
            "description": {
              "content": "Give the startDate and endDate parameters as request parameters in the /request-files endpoint, it returns the jobID. startDate and endDate should be in YYYY-MM-DDTHH:MM:SSZ format. This API only supports adhoc requests to retrieve historical files and does not support real-time files and if you interested in require real-time push should consider the other three methods (pushed via SFTP, to QNT account, or your Azure Storage). Per API request able to query till 2 years of data",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "streetaccount",
                "historical",
                "request-files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "(Required) Date from which data is required. Should be YYYY-MM-DDTHH:MM:SSZ format"
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "(Required) The date until which the data is to be fetched. Should be YYYY-MM-DDTHH:MM:SSZ format"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
