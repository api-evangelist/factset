              "body": "{\n  \"typeahead\": {\n    \"result_count\": {\n      \"equities\": 25\n    },\n    \"error\": \"null\",\n    \"is_success\": 1,\n    \"results\": [\n      {\n        \"index\": \"equities\",\n        \"symbol\": \"A-US\",\n        \"name\": \"Agilent Technologies,Inc.\",\n        \"entity_id\": \"002LV5-E\"\n      },\n      {\n        \"index\": \"equities\",\n        \"symbol\": \"AAPL-US\",\n        \"name\": \"Apple Inc.\",\n        \"entity_id\": \"000C7F-E\"\n      }\n    ]\n  }\n}",
