                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"query\": {\n    \"pattern\": \"A\",\n    \"entities\": [\n      \"equities\"\n    ]\n  },\n  \"settings\": {\n    \"result_limit\": 25\n  }\n}",
                  "options": {
                    "raw": {
