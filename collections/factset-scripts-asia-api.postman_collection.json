{
  "item": [
    {
      "id": "a4ae99bb-6b2d-4a39-8ff3-30bd8b952c55",
      "name": "Scripts Asia",
      "description": {
        "content": "Scripts Asia API provides access to Asia Pacific regional collected transcripts.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "33a4a227-be72-43fe-9e3a-a5fb43ba2183",
          "name": "Returns the daily files from Open:FactSet Partner - Scripts Asia.",
          "request": {
            "name": "Returns the daily files from Open:FactSet Partner - Scripts Asia.",
            "description": {
              "content": "Returns XML files and relevant metadata provided by Open: FactSet Partner – Scripts Asia.\n- type=delta returns the files from March 1st 2023 to current date.\n- type=full will returns the files from start of date until Feb 28th 2023.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "scripts-asia",
                "transcripts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "_sort",
                  "value": "-startDate",
                  "description": "Enables to get the data in ascending or descending order based on startTime. Results are in reverse chronological order if this parameter is not used."
                },
                {
                  "disabled": false,
                  "key": "_paginationLimit",
                  "value": "20",
                  "description": "Specifies the maximum number of results to return per result."
                },
                {
                  "disabled": false,
                  "key": "_paginationOffset",
                  "value": "0",
                  "description": "Specifies the starting point for pagination. This parameter is used to identify the beginning of next set of results. Using this parameter can fetch maximum of first 10000 records."
                },
                {
                  "disabled": false,
                  "key": "trackingId",
                  "value": "<string>",
                  "description": "Unique Scripts Asia identifier assigned to an event.\n"
                },
                {
                  "disabled": false,
                  "key": "saId",
                  "value": "<string>",
                  "description": "This parameter filters the results based on saId of the Transcript.\n"
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<date>",
                  "description": "The earliest date of the Scripts Asia file the API should return based on date.\n"
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<date>",
                  "description": "The latest date of the Scripts Asia file the API should return based on date.         \n"
                },
                {
                  "disabled": false,
                  "key": "companyName",
                  "value": "<string>",
                  "description": "This parameter filters the results based on Company Name of the Transcript.\n"
                },
                {
                  "disabled": false,
                  "key": "eventType",
                  "value": "<string>",
                  "description": "This parameter filters the results based on eventType of the Transcript.\n\n* 01 = Shareholders Meeting\n* 02 = Earnings Announcement\n* 03 = Medium-term Management Plan Announcement\n* 04 = Analyst Meeting\n* 05 = Special Announcement\n* 06 = Investor Conference\n"
                },
                {
                  "disabled": false,
                  "key": "languageType",
                  "value": "local",
                  "description": "This parameter filters the results based on language type(either English or local) of the Transcript.\n"
                },
                {
                  "disabled": false,
                  "key": "fileName",
                  "value": "<string>",
                  "description": "This parameter is used to filters the results based on file name."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "delta",
                  "description": "Specifies the type of the file."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
