{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Currencies API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Currencies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Get Currencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/analytics/lookups/v3/currencies"
          },
          "docs": "This endpoint lists all the currencies that can be applied to any calculation."
        }
      ]
    }
  ],
  "bundled": true
}