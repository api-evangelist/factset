          "name": "Factset Kick off request to create template with reports of your choice",
          "request": {
            "name": "Factset Kick off request to create template with reports of your choice",
            "description": {
              "content": "This end point retrieves template name and template_id of the template you create. All the book options such as name of the template, type, and reports can be specified in the request body. Please refer to the documentation for valid section ids and report ids.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "create-template",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tmpl_name\": \"<string>\",\n  \"tmpl_type\": \"<string>\",\n  \"content\": [\n    {\n      \"section_id\": {},\n      \"reports\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    },\n    {\n      \"section_id\": {},\n      \"reports\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  ]\n}",
              "options": {
