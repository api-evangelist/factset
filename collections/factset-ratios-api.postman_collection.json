{
  "item": [
    {
      "id": "636b30a6-6297-4498-b15c-d939f984cfb3",
      "name": "Ratios",
      "description": {
        "content": "Access pre-calculated financial ratios including profitability, liquidity, growth rates, size, and valuation metrics.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f7a3f850-e49f-4c70-b12c-f767c6f0d8a9",
          "name": "Factset Returns Pre-calculated Financial Ratios.",
          "request": {
            "name": "Factset Returns Pre-calculated Financial Ratios.",
            "description": {
              "content": "Retrieves pre-calculated financial ratios for specified securities. Available ratio subcategories include FINANCIAL, GROWTH_RATE, LIQUIDITY, PROFITABILITY, SIZE, and VALUATION.\n\nCommon ratios include price-to-earnings (FF_PE), return on equity (FF_ROE), debt-to-equity (FF_DEBT_EQUITY), current ratio (FF_CURR_RATIO), and many others.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ratios"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "(Required) The requested list of security identifiers. Accepted ID types include Market Tickers, SEDOL, ISINs, CUSIPs, or FactSet Permanent Ids. Limit of 1,000 per non-batch request / 2,000 per batch request (GET) or 30,000 per batch request (POST)."
                },
                {
                  "disabled": false,
                  "key": "metrics",
                  "value": "<string>",
                  "description": "(Required) Requested list of ratio metrics. Common ratios include FF_PE (price-to-earnings), FF_PBK (price-to-book), FF_ROE (return on equity), FF_DEBT_EQUITY, FF_CURR_RATIO, and others. Use the `/metrics` endpoint with category=RATIOS for a complete list."
                },
                {
                  "disabled": false,
                  "key": "subcategory",
                  "value": "<string>",
                  "description": "Filter ratios by subcategory. FINANCIAL for leverage and coverage ratios, GROWTH_RATE for revenue and earnings growth, LIQUIDITY for current and quick ratios, PROFITABILITY for margin and return metrics, SIZE for market cap and enterprise value, VALUATION for PE, PB, and dividend yield."
                },
                {
                  "disabled": false,
                  "key": "periodicity",
                  "value": "ANN",
                  "description": "Periodicity or frequency of the fiscal periods. ANN = Annual Original, ANN_R = Annual Latest (includes restatements), QTR = Quarterly Original, QTR_R = Quarterly Latest, SEMI = Semi-Annual, SEMI_R = Semi-Annual Latest, LTM = Last Twelve Months, LTM_R = Last Twelve Months Latest, LTMSG = Last Twelve Months Global, LTM_SEMI = Last Twelve Months Semi-Annual, YTD = Year-to-date."
                },
                {
                  "disabled": false,
                  "key": "fiscalPeriodStart",
                  "value": "<date>",
                  "description": "The fiscal period start expressed as YYYY-MM-DD. Calendar date that will fall back to the most recent completed period during resolution."
                },
                {
                  "disabled": false,
                  "key": "fiscalPeriodEnd",
                  "value": "<date>",
                  "description": "The fiscal period end expressed as YYYY-MM-DD. Calendar date that will fall back to the most recently completed period during resolution."
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "LOCAL",
                  "description": "Currency code for currency values. For a list of currency ISO codes, visit Online Assistant Page 1470. Use \"DOC\" for reporting currency. Defaults to LOCAL."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
