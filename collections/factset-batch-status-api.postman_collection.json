        {
          "id": "2863cd85-2ffd-4c19-9b7a-63cac61e02d7",
          "name": "Factset Returns the status for a Batch Request",
          "request": {
            "name": "Factset Returns the status for a Batch Request",
            "description": {
              "content": "Return the status for the underlying batch request that is specified by the id.\n\n  The Formula API supports Long Running asynchronous requests up to **20 minutes** via the `batch` parameter in the `/time-series` endpoint and up to **10 minutes** in the `/cross-sectional` endpoint.\n\n  *This feature is available to Individual Users subscribed to the Performance Package and Performance Package Plus Performance Tiers and all Production Users. If you are unsure which Performance Tier you are subscribed to or you would like to gain access to the batch capabilities, please contact your FactSet Account Team or \"Report Issue\" above and our support teams can assist.*\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "batch-status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<uuid>",
                  "description": "(Required) Batch Request identifier."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
