{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Subjects API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subjects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Get All Subjects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/v1/subjects",
            "headers": [
              {
                "name": "X-IRN-Ignore-Permissions",
                "value": ""
              }
            ]
          },
          "docs": "Factset Get All Subjects"
        },
        {
          "info": {
            "name": "Factset Get Subject Details for the Given Id Provided",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/v1/subjects/:subjectId",
            "headers": [
              {
                "name": "X-IRN-Ignore-Permissions",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "subjectId",
                "value": "",
                "type": "path",
                "description": "Id"
              }
            ]
          },
          "docs": "Factset Get Subject Details for the Given Id Provided"
        }
      ]
    }
  ],
  "bundled": true
}