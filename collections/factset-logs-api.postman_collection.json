          "name": "Factset Gets a List of Logs for the Report Instance Generation",
          "request": {
            "name": "Factset Gets a List of Logs for the Report Instance Generation",
            "description": {
              "content": "Gets a list of logs for the generated report instance. Allows the user to sort on log message, type and date. Also allows for retrieving of just the errors & warnings'",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                ":tenant",
                "report-instances",
                ":reportInstanceId",
                "logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "errorsOnly",
                  "value": "<string>",
                  "description": "If the parameter is set to true the endpoint should return just errors and warnings E.g: errorsOnly=true"
                },
                {
                  "disabled": false,
                  "key": "_sort",
                  "value": "<string>",
                  "description": "The column to sort on. Can add - to sort"
                },
                {
                  "disabled": false,
                  "key": "_paginationLimit",
                  "value": "<integer>",
                  "description": "Non-negative maximum number of entries to return"
                },
                {
                  "disabled": false,
                  "key": "_paginationOffset",
                  "value": "<integer>",
                  "description": "Non-negative number of entries to skip"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "tenant",
                  "description": "(Required) The code of the tenancy"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportInstanceId",
                  "description": "(Required) Used to validate that report file name belongs to the report instance passed"
