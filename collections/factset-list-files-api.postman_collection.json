          "name": "Factset Snapshot",
          "request": {
            "name": "Factset Snapshot",
            "description": {
              "content": "A service that provides access to Real Time or Delayed data snapped at hourly intervals for an entire Exchange",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "list-files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "product",
                  "value": "<integer>",
                  "description": "(Required) any product subscribed by client. Minimum value for prod code=9001"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) YYYYMMDD (Choose between 1 and 4 previous trading days)"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "(Required) YYYYMMDD (Choose between 1 and 4 previous trading days, greater than or equal to start date)"
                },
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "<string>",
                  "description": "(Required) HHMM (24 hour time EST)"
                },
                {
                  "disabled": false,
                  "key": "end_time",
                  "value": "<time>",
                  "description": "(Required) HHMM (24 hour time EST)"
                },
                {
                  "disabled": false,
                  "key": "access",
                  "value": "DL",
                  "description": "Option to select from static, DL or RT data"
                }
              ],
              "variable": []
            },
            "header": [
              {
