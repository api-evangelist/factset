{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Sales API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sales",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetClientsSalesRepresentative",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/v1/group/client-sales-representative"
          }
        }
      ]
    }
  ],
  "bundled": true
}