  "item": [
    {
      "id": "6e45b37e-dc8e-4f33-a13a-437bb689b15b",
      "name": "Surprise",
      "description": {
        "content": "The Surprise Events reflecting the company's reported financials against the broker's estimates.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6aac34df-2f20-4598-94b7-ebdf0e999c4e",
          "name": "Factset Surprise Estimates for Rolling Fiscal Periods",
          "request": {
            "name": "Factset Surprise Estimates for Rolling Fiscal Periods",
            "description": {
              "content": "Returns FactSet Estimates surprise data using rolling fiscal dates.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "factset-estimates",
                "v2",
                "surprise"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "(Required) Security or Entity identifiers. FactSet Identifiers, tickers, CUSIP and SEDOL are accepted input. <p>***ids limit** =  3000 per request*</p> * Make Note - id limit of 3000 for defaults, otherwise the service is limited to a 30 second duration. This can be reached when increasing total number of metrics requested and depth of history. *\n"
                },
                {
                  "disabled": false,
                  "key": "metrics",
                  "value": "<string>",
                  "description": "(Required) Requested metrics. Use the /metrics endpoint to return a list of available estimate items. Note, the number of metrics you are allowed to supply is limited to 1 for now. **Top 10** most used metrics are **EPS, SALES, DPS, EBITDA,EBIT, PRICE_TGT, CFPS, BPS, NET_INC, and ASSETS**.  For more details, visit [Online Assistant Page #15034](https://oa.apps.factset.com/pages/15034).\n"
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<string>",
                  "description": "Start date for point in time of estimates expressed in YYYY-MM-DD format."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<string>",
                  "description": "End date for point in time of estimates expressed in YYYY-MM-DD format."
                },
                {
                  "disabled": false,
                  "key": "frequency",
                  "value": "D",
                  "description": "Controls the frequency of the data returned.\n  * **D** = Daily\n  * **W** = Weekly, based on the last day of the week of the start date.\n  * **AM** = Monthly, based on the start date (e.g., if the start date is June 16, data is displayed for June 16, May 16, April 16 etc.).      \n  * **AQ** = Quarterly, based on the start date.\n  * **AY** = Actual Annual, based on the start date. \n"
                },
                {
                  "disabled": false,
                  "key": "periodicity",
                  "value": "ANN",
                  "description": "The periodicity for the estimates requested, allowing you to fetch Quarterly, Semi-Annual and Annual Estimates.\n  * **ANN** - Annual\n  * **QTR** - Quarterly\n  * **SEMI** - Semi-Annual \n"
                },
                {
                  "disabled": false,
                  "key": "statistic",
                  "value": "MEAN",
                  "description": "Statistic for consensus calculation."
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "<string>",
                  "description": "Currency code for adjusting the data. Use 'ESTIMATE' as input value for the values in Estimate Currency. For a list of currency ISO codes, visit [Online Assistant Page #1470](https://oa.apps.factset.com/pages/1470)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
