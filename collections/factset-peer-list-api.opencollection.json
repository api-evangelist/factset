{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Peer List API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Peer List",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Peer List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/peer-list",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Company ticker"
              },
              {
                "name": "topn",
                "value": "",
                "type": "query",
                "description": "Limits the number of peers returned."
              }
            ]
          },
          "docs": "Factset Peer List"
        }
      ]
    }
  ],
  "bundled": true
}