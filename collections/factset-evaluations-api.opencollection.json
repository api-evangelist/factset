{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Evaluations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Evaluations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Evaluate a portfolio.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.factset.com/portfolio/evaluation/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Performs an evaluation over a period of time and returns portfolio key figures for each day, week, or month."
        }
      ]
    }
  ],
  "bundled": true
}