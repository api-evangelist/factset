{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Book List API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Book List",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset Check out the books that are in the book library",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/v1/book-list"
          },
          "docs": "Retrieves the list of books that were previously created and are available in the client's book library"
        }
      ]
    }
  ],
  "bundled": true
}