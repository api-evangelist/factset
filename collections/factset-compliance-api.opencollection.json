{
  "opencollection": "1.0.0",
  "info": {
    "name": "Factset Analytics Datastore About Compliance API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Compliance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Factset List of Compliance Properties for Instruments.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.factset.com/instrument/complianceProperty/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List of compliance properties for instruments."
        },
        {
          "info": {
            "name": "Factset Compliance Properties of an Instrument.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/instrument/complianceProperty/listByInstrument",
            "params": [
              {
                "name": "identifier",
                "value": "",
                "type": "query"
              },
              {
                "name": "identifierType",
                "value": "",
                "type": "query"
              },
              {
                "name": "_attributes",
                "value": "",
                "type": "query",
                "description": "Limit the attributes returned in the response to the specified set."
              },
              {
                "name": "_language",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Compliance properties of an instrument."
        },
        {
          "info": {
            "name": "Factset Role-specific Compliance Properties of Legal Entities Related to an Instrument.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.factset.com/instrument/legalEntity/complianceProperty/list",
            "params": [
              {
                "name": "identifier",
                "value": "",
                "type": "query"
              },
              {
                "name": "identifierType",
                "value": "",
                "type": "query"
              },
              {
                "name": "_attributes",
                "value": "",
                "type": "query",
                "description": "Limit the attributes returned in the response to the specified set."
              },
              {
                "name": "_language",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Role-specic compliance properties of legal entities related to an instrument."
        }
      ]
    }
  ],
  "bundled": true
}